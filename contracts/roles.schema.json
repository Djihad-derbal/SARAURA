{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "saraura/roles.schema.json",
  "title": "Roles (questions/roles.yaml)",
  "description": "Who asks which Questions, per Lens. Same evidence, different questions for different people.",
  "type": "object",
  "propertyNames": {"$ref": "site.schema.json#/$defs/lens"},
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "questions"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z_]+$"},
        "label": {"type": "string"},
        "questions": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    }
  }
}
