# Copy this file to ".env" and paste your NASA Earthdata token after the = sign.
# Get a token: sign in at https://urs.earthdata.nasa.gov -> "Generate Token" -> "Generate Token".
# Tokens expire after about 60 days. Never commit the real .env file.
EARTHDATA_TOKEN=

# Optional: enables the Assistant (Gemini). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
